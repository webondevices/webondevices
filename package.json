{
  "name": "webondevices",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build:demos": "npm --prefix demos/3d-product-page ci --no-audit --no-fund && npm --prefix demos/3d-product-page run build",
    "build": "npm run build:demos && next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "format": "prettier --write .",
    "test": "node --test \"worker/**/*.test.ts\"",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "preview": "NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA npm run build && wrangler dev",
    "deploy": "npm run build && node --test scripts/url-parity.test.ts && wrangler deploy",
    "test:urls": "node --test scripts/url-parity.test.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "iconoir-react": "^7.12.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-unwrap-images": "^1.0.0",
    "remark-gfm": "^4.0.1",
    "sugar-high": "^2.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.157.0"
  }
}
